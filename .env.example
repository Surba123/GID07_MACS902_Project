# Copy to .env and replace this placeholder with a locally generated random value.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-new-random-local-value

# Required only for PKI administration commands. Use distinct random values.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
PKI_CA_KEY_PASSWORD=replace-with-a-new-random-ca-key-password
# Legacy Phase 2/3 development CLI records only; Phase 4 user keys use their account password.
PKI_DEVELOPMENT_USER_KEY_PASSWORD=replace-with-a-new-random-user-key-password

# Optional non-secret display names for locally generated CA certificates.
PKI_ROOT_CA_NAME=MACS902 Classroom Root CA
PKI_ISSUING_CA_NAME=MACS902 Classroom Issuing CA

# Optional. Default: instance/macs902.db. Keep any custom database outside Git.
# DATABASE_URL=sqlite:///absolute/path/to/local.db

# Optional. Default: instance/storage. Keep any custom storage outside public static.
# STORAGE_ROOT=absolute/path/to/private/storage
